//funcao para tocar uma nota
void playNote(int frequency, int duration){
  if (frequency > 0){
    tone(buzzer,frequency, duration);
  }
  delay(duration + 30);
}

void setup(){
  Serial.begin(9600);
  pinMode(buzzer, OUTPUT);
}

